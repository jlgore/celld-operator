# Image for cmd/isolation-proxy (tenant storage proxy and admin gateway).
# Kept separate from the operator's Dockerfile so the upstream file is
# untouched.
FROM golang:1.26.10@sha256:cfa27959837144bf4649802ba38e59daffd0dd2a7994aa83daaf113285b0f551 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/isolation-proxy/ cmd/isolation-proxy/
COPY internal/isolation/ internal/isolation/
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o isolation-proxy ./cmd/isolation-proxy

FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
WORKDIR /
COPY --from=builder /workspace/isolation-proxy .
USER 65532:65532
ENTRYPOINT ["/isolation-proxy"]
